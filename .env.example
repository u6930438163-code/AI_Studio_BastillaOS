# ── Czat Triady (Alex, Astyria, Aurelius): swobodna rozmowa ──────────────
# Kolejność: Ollama jako główna, Gemini jako awaryjna (brak uruchomionej Ollamy nie jest ukrywany).
LLM_PROVIDERS="ollama,gemini"
# Awaryjny without_nlp po awarii modeli (domyślnie off = czat zwraca błąd).
CHAT_LOCAL_FALLBACK="off"
# Best-fit router: krótkie pytania o stan systemu dostają natychmiastową odpowiedź bez modelu ("off" wyłącza).
BEST_FIT_ROUTER="on"

# ── Google Gemini API (zautomatyzowane w AI Studio) ────────────────────────
# GEMINI_API_KEY: Wymagany do połączenia z Google Gemini.
# AI Studio automatycznie wstrzykuje ten klucz w czasie działania z sekretów użytkownika.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.1-flash-lite"
# Modele zapasowe Gemini (po przecinku), używane przy limicie 429 / braku modelu.
GEMINI_FALLBACK_MODELS=""

# ── xAI (Grok) ──────────────────────────────────────────────────────────────
# https://console.x.ai/
XAI_API_KEY=""
XAI_MODEL=""
XAI_BASE_URL="https://api.x.ai/v1"

# ── Ollama (Lokalne LLM) ────────────────────────────────────────────────────
# Wymaga faktycznie uruchomionego hosta Ollama i odpowiedniej pamięci na model 11B.
# Adres 127.0.0.1 oznacza kontener uruchamiający backend, a NIE komputer użytkownika.
# Przy zdalnym Ollama zastosuj uwierzytelniony HTTPS reverse proxy, nie otwieraj 11434 publicznie.
# Instalacja na własnym hoście: npm run setup:ollama
OLLAMA_MODEL="llama3.2-vision:11b"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_KEEP_ALIVE="24h"   # model zostaje w pamięci
OLLAMA_NUM_CTX="4096"     # okno kontekstu
OLLAMA_NUM_THREAD=""      # automatyczna liczba wątków CPU
OLLAMA_NUM_PREDICT="3072" # maks. długość odpowiedzi w tokenach
LLM_TIMEOUT_SEC="70"

# ── OpenRouter API (HyperOS) ────────────────────────────────────────────────
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="minimax/minimax-m3.1-flash:free"

# ── Fallback NLP (Groq / OpenAI API) ────────────────────────────────────────
FALLBACK_NLP_BASE_URL="https://api.groq.com/openai/v1"
FALLBACK_NLP_API_KEY=""
FALLBACK_NLP_MODEL="openai/gpt-oss-120b"

# ── Inne Zmienne Środowiskowe ───────────────────────────────────────────────
POLLINATIONS_API_KEY="MY_POLLINATIONS_API_KEY"
APP_URL="MY_APP_URL"
PORT="3000"


# ── OpenAI image generation (optional, separately billed API) ──
# Set as a deployment secret; never commit a real key.
OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL="gpt-image-1"

# Maximum incoming request body size in MiB (1-1024, default 1024).
# Base64 file attachments increase request size by about 33%.
BASTILLA_UPLOAD_MAX_MB=1024

# GPT Actions (REST, no MCP). Disabled until both values are set.
# Public HTTPS origin only, e.g. https://your-deployed-app.example
GPT_ACTIONS_PUBLIC_URL=""
# Set a fresh random secret (32+ characters) in deployment secrets, never in git.
GPT_ACTIONS_TOKEN=""
