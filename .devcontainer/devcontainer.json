{
  "name": "SVL System",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [
    3000,
    3001
  ],
  "containerEnv": {
    "HOST": "0.0.0.0",
    "LLM_PROVIDERS": "none",
    "CHAT_LOCAL_FALLBACK": "on"
  },
  "postStartCommand": "setsid nohup bash scripts/keep-alive.sh > /dev/null 2>&1 &"
}
