{
  "name": "BastillaOS — Codespaces",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "forwardPorts": [
    3000,
    8000
  ],
  "portsAttributes": {
    "3000": {
      "label": "BastillaOS web",
      "onAutoForward": "openPreview",
      "visibility": "private"
    },
    "8000": {
      "label": "BastillaOS MCP (private)",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },
  "postCreateCommand": "npm ci && python3 --version && node --version && (docker compose version || echo 'Docker Compose unavailable; BastillaOS web app can still run')",
  "postStartCommand": "bash scripts/start-codespaces.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
